include($KDE_DOCS/global/qt-module-defaults.qdocconf)

project = KIMAP
moduleheader = kimap_qdocmoduleheader.h
description = A job-based API for interacting with IMAP servers.


documentationinheaders = true

headers += \
    acl.h \
    acljobbase.h \
    appendjob.h \
    capabilitiesjob.h \
    closejob.h \
    copyjob.h \
    createjob.h \
    deleteacljob.h \
    deletejob.h \
    enablejob.h \
    expungejob.h \
    fetchjob.h \
    getacljob.h \
    getmetadatajob.h \
    getquotajob.h \
    getquotarootjob.h \
    idjob.h \
    idlejob.h \
    imapset.h \
    job.h \
    kimap_qdocmoduleheader.h \
    listjob.h \
    listrightsjob.h \
    loginjob.h \
    logoutjob.h \
    metadatajobbase.h \
    movejob.h \
    myrightsjob.h \
    namespacejob.h \
    quotajobbase.h \
    renamejob.h \
    searchjob.h \
    selectjob.h \
    session.h \
    sessionuiproxy.h \
    setacljob.h \
    setmetadatajob.h \
    setquotajob.h \
    statusjob.h \
    storejob.h \
    subscribejob.h \
    unsubscribejob.h
sourcedirs += .

outputformats = HTML

depends += \
    qtcore \
    kcoreaddons

navigation.landingpage = "KIMAP"

qhp.projects            = kimap

qhp.kimap.file                = kimap.qhp
qhp.kimap.namespace           = org.kde.kimap.$QT_VERSION_TAG
qhp.kimap.virtualFolder       = kimap
qhp.kimap.indexTitle          = KIMAP
qhp.kimap.indexRoot           =

qhp.kimap.subprojects         = classes
qhp.kimap.subprojects.classes.title = C++ Classes
qhp.kimap.subprojects.classes.indexTitle = KIMAP C++ Classes
qhp.kimap.subprojects.classes.selectors = class fake:headerfile
qhp.kimap.subprojects.classes.sortPages = true

tagfile = kimap.tags
